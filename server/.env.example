# Copy to server/.env and fill in. Never commit the real .env.
# The postgres user/password/db below must match the root .env used by docker-compose.

# Postgres connection string
DATABASE_URL="postgresql://postgres:<YOUR_POSTGRES_PASSWORD>@localhost:5432/nationwide_sales_distribution_system"

# API port. Keep it off 3000 - the Next.js client uses that.
PORT=4000

# Better Auth session secret (min 32 chars). Generate one: openssl rand -base64 32
BETTER_AUTH_SECRET=<YOUR_BETTER_AUTH_SECRET>

# Public URL of this API server (no path)
BETTER_AUTH_URL=http://localhost:4000

# Used once by `npm run create-admin` to bootstrap the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# development | production | test
NODE_ENV=development

# Redis connection string (matches docker-compose)
REDIS_URL=redis://localhost:6379

# Origins allowed by CORS, comma-separated, exact match (scheme + host + port)
FRONTEND_URL=http://localhost:3000
