# Credentials for the containers started by docker-compose.yml.
# Copy to .env (`cp .env.example .env`) and fill in before running `docker compose up -d`.
# These must match the DATABASE_URL / REDIS_URL you set in server/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=nationwide_sales_distribution_system
POSTGRES_PORT=5432

REDIS_PORT=6379
